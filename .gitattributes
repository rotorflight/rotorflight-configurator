# Check out every text file with LF line endings, on Windows and in WSL,
# whatever core.autocrlf is set to. Git detects binary files itself.
* text=auto eol=lf

# Inno Setup installer script is kept with CRLF line endings.
assets/windows/installer.iss -text

# Binary files
*.hex binary
*.elf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.glb binary
*.zip binary
